# 1. Comentario no topo do arquivo (antes do main)

sub int dobro(int n) # 2. Comentario na assinatura da subrotina
    # 3. Comentario alinhado dentro da subrotina
      # 4. Comentario com indentacao extra (nao deve emitir INDENT)
